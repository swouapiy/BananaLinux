#!/bin/sh
# The USB-C port's controller (dwc3 at fcc00000; this kernel has no USB gadget side, so it runs as a host, its xHCI
# always up) fails the suspend: "xhci-hcd.0.auto: Clearing Run/Stop bit failed -110", the first try of almost every
# sleep given up after seconds, the retry slower and the controller and its PHY maybe powered through it. ROCKNIX's
# kernel runs it as a USB device, idle when nothing is plugged in. Here: unbound before the sleep, bound after, so it
# is off while asleep; a pad plugged into it comes back at the wake.
D=fcc00000.usb; S=/sys/bus/platform/drivers/dwc3
case $1 in
pre)
    [ -e $S/$D ] || exit 0
    echo $D > $S/unbind 2>/dev/null && touch /run/banana/usb-unbound
    ;;
post)
    [ -f /run/banana/usb-unbound ] || exit 0
    rm -f /run/banana/usb-unbound
    echo $D > $S/bind 2>/dev/null
    ;;
esac
exit 0
