# Banana: what its scripts use beyond Buildroot's busybox configuration
# the clock from the network once Wi-Fi is up (usr/libexec/banana/wifi)
CONFIG_NTPD=y
# /etc/sysctl.d/banana.conf at boot (rcS)
CONFIG_SYSCTL=y
# PortMaster (its menu checks for running processes with pgrep -f) and port scripts
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_TIMEOUT=y
# the power LED lit as it starts (rcK: devmem sets BOOT_CHARGING before restarting into charging, uboot-patches/004)
CONFIG_DEVMEM=y
