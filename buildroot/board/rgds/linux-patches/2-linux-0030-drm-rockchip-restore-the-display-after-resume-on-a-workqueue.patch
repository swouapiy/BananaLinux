From: swouapiy <swouapiy@gmail.com>
Subject: [PATCH] drm/rockchip: restore the display after resume on a workqueue

The RG DS Plus has two DSI panels; restoring the display state at resume
powers both up and runs their init sequences one after the other. That
happens inside the display subsystem's resume callback, so every device
after it and all of user space wait for it: on the handheld the screens
took 2.7 s to come back after a key press.

Queue the restore on system_unbound_wq and return at once, as phones do
(their display comes up in parallel with the rest of the resume). The
rest of the system resumes and thaws meanwhile; a commit from user space
waits on the modeset locks the restore holds. A suspend flushes a restore
still in flight first.
---
 drivers/gpu/drm/rockchip/rockchip_drm_drv.c | 33 ++++++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
--- a/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_drv.c
@@ -16,6 +16,7 @@
 #include <linux/component.h>
 #include <linux/console.h>
 #include <linux/iommu.h>
+#include <linux/workqueue.h>
 
 #include <drm/clients/drm_client_setup.h>
 #include <drm/drm_drv.h>
@@ -243,9 +244,33 @@
 };
 
 #ifdef CONFIG_PM_SLEEP
+/*
+ * Restoring the display at resume brings the DSI panels out of reset and
+ * through their init sequences, which takes hundreds of milliseconds of
+ * mostly sleeping. Done in the resume callback it holds up every device
+ * after it and keeps user space frozen until the panels are lit. Do it on
+ * a workqueue instead, as phones do: the rest of the system resumes and
+ * thaws meanwhile, and anyone touching the display waits on the modeset
+ * locks the restore holds.
+ */
+static struct drm_device *rockchip_drm_resuming;
+
+static void rockchip_drm_resume_work_fn(struct work_struct *work)
+{
+	int ret = drm_mode_config_helper_resume(rockchip_drm_resuming);
+
+	if (ret)
+		drm_err(rockchip_drm_resuming, "resume failed: %d\n", ret);
+}
+
+static DECLARE_WORK(rockchip_drm_resume_work, rockchip_drm_resume_work_fn);
+
 static int rockchip_drm_sys_suspend(struct device *dev)
 {
 	struct drm_device *drm = dev_get_drvdata(dev);
+
+	/* a suspend right after a resume: the restore first */
+	flush_work(&rockchip_drm_resume_work);
 
 	return drm_mode_config_helper_suspend(drm);
 }
@@ -254,7 +279,13 @@
 {
 	struct drm_device *drm = dev_get_drvdata(dev);
 
-	return drm_mode_config_helper_resume(drm);
+	if (!drm)
+		return 0;
+
+	rockchip_drm_resuming = drm;
+	queue_work(system_unbound_wq, &rockchip_drm_resume_work);
+
+	return 0;
 }
 #endif
 
