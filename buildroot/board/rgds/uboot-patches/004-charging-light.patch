From: swouapiy
Subject: [PATCH] rockchip: the RG DS charging light lit from U-Boot when a charger is in

diff -ruN a/arch/arm/dts/rk3566-quartz64-a-u-boot.dtsi b/arch/arm/dts/rk3566-quartz64-a-u-boot.dtsi
--- a/arch/arm/dts/rk3566-quartz64-a-u-boot.dtsi	2026-10-27 09:29:34
+++ b/arch/arm/dts/rk3566-quartz64-a-u-boot.dtsi	2026-10-27 09:29:47
@@ -40,3 +40,20 @@
 &vcc_sd_h {
 	bootph-pre-ram;
 };
+
+/* Banana: the RG DS's charging light (amber, PWM6), lit by board.c when a charger is in */
+&pwm6 {
+	status = "okay";
+};
+
+/ {
+	banana-leds {
+		compatible = "pwm-leds";
+
+		banana-charging {
+			label = "banana-charging";
+			max-brightness = <255>;
+			pwms = <&pwm6 0 25000 0>;
+		};
+	};
+};
diff -ruN a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
--- a/arch/arm/mach-rockchip/board.c	2026-10-27 09:29:34
+++ b/arch/arm/mach-rockchip/board.c	2026-10-27 09:29:47
@@ -25,6 +25,8 @@
 #include <part.h>
 #include <ram.h>
 #include <syscon.h>
+#include <led.h>
+#include <power/pmic.h>
 #include <u-boot/uuid.h>
 #include <u-boot/crc.h>
 #include <u-boot/sha256.h>
@@ -184,8 +186,32 @@
 }
 #endif /* CONFIG_EFI_HAVE_CAPSULE_SUPPORT && CONFIG_EFI_PARTITION */
 
+/*
+ * Banana (RG DS, RG DS Plus): the charging light (amber, on PWM6) lit as soon as U-Boot runs with a charger in, so
+ * plugging in while off shows it within a second, as a phone does; Linux keeps it (default-state = "keep") until
+ * bananad takes it over. Unplugged it is set off, which also gives the PWM its period for Linux to read back.
+ */
+#define BANANA_RK817_SYS_STS		0xf0
+#define BANANA_RK817_PLUG_IN_STS	BIT(6)
+
+static void banana_charging_light(void)
+{
+	struct udevice *pmic, *led;
+	int sts;
+
+	if (!CONFIG_IS_ENABLED(LED_PWM) || !CONFIG_IS_ENABLED(PMIC_RK8XX))
+		return;
+	if (uclass_get_device_by_driver(UCLASS_PMIC, DM_DRIVER_GET(rockchip_rk805), &pmic))
+		return;
+	sts = pmic_reg_read(pmic, BANANA_RK817_SYS_STS);
+	if (sts < 0 || led_get_by_label("banana-charging", &led))
+		return;
+	led_set_state(led, sts & BANANA_RK817_PLUG_IN_STS ? LEDST_ON : LEDST_OFF);
+}
+
 __weak int rk_board_late_init(void)
 {
+	banana_charging_light();
 	return 0;
 }
 
