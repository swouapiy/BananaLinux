# the libretro cores, one per system in /etc/banana/systems.conf (each built and checked for aarch64)

config BR2_PACKAGE_LIBRETRO_GPSP
	bool "libretro-gpsp"
	default y
	help
	  Game Boy Advance, with its ARM64 dynamic recompiler.

config BR2_PACKAGE_LIBRETRO_MGBA
	bool "libretro-mgba"
	default y
	help
	  Game Boy Advance, accurate and with RetroAchievements support
	  (gpSP has none): chosen per system in Settings.

config BR2_PACKAGE_LIBRETRO_BANANAGBA
	bool "libretro-bananagba"
	default y
	help
	  BananaGBA: BananaOS's mGBA for the RG DS and RG DS Plus (the picture drawn
	  on a second core), as bananagba_libretro.so: chosen per system in Settings.

config BR2_PACKAGE_LIBRETRO_GAMBATTE
	bool "libretro-gambatte"
	default y
	help
	  Game Boy and Game Boy Color.

config BR2_PACKAGE_LIBRETRO_FCEUMM
	bool "libretro-fceumm"
	default y
	help
	  NES and Famicom.

config BR2_PACKAGE_LIBRETRO_BANANANES
	bool "libretro-banananes"
	default y
	help
	  NES and Famicom: BananaNES, a fork of FCEUmm tuned for the RG DS and RG DS Plus (same saves, states and
	  core options as FCEUmm). Chosen per system in Settings > Other systems; the default after the device checks.

config BR2_PACKAGE_LIBRETRO_SNES9X
	bool "libretro-snes9x"
	default y
	help
	  Super Nintendo.

config BR2_PACKAGE_LIBRETRO_BANANASNES
	bool "libretro-bananasnes"
	default y
	help
	  BananaSNES: the Super Nintendo core BananaFront runs (a Snes9x fork tuned for the RG DS / RG DS Plus).

config BR2_PACKAGE_LIBRETRO_PICODRIVE
	bool "libretro-picodrive"
	default y
	help
	  Mega Drive, Master System, Mega CD and 32X.

config BR2_PACKAGE_LIBRETRO_PCSX_REARMED
	bool "libretro-pcsx-rearmed"
	default y
	help
	  PlayStation, with its ARM64 dynamic recompiler (ari64) and NEON GPU.

config BR2_PACKAGE_LIBRETRO_MUPEN64PLUS_NEXT
	bool "libretro-mupen64plus-next"
	default y
	help
	  Nintendo 64, with GLES3 and its ARM64 dynamic recompiler.

config BR2_PACKAGE_LIBRETRO_FAKE08
	bool "libretro-fake08"
	default y
	help
	  PICO-8 carts (.p8 and .p8.png), when the official PICO-8 isn't on the card.

config BR2_PACKAGE_LIBRETRO_RACE
	bool "libretro-race"
	default y
	help
	  Neo Geo Pocket and Neo Geo Pocket Color.

config BR2_PACKAGE_LIBRETRO_BEETLE_WSWAN
	bool "libretro-beetle-wswan"
	default y
	help
	  WonderSwan and WonderSwan Color (Mednafen's).

config BR2_PACKAGE_LIBRETRO_HANDY
	bool "libretro-handy"
	default y
	help
	  Atari Lynx (its BIOS, lynxboot.img, in bios/).

config BR2_PACKAGE_LIBRETRO_BEETLE_VB
	bool "libretro-beetle-vb"
	default y
	help
	  Virtual Boy (Mednafen's).

config BR2_PACKAGE_LIBRETRO_POKEMINI
	bool "libretro-pokemini"
	default y
	help
	  Pokémon mini.

config BR2_PACKAGE_LIBRETRO_GW
	bool "libretro-gw"
	default y
	help
	  Game & Watch (and other LCD handhelds), from .mgw files.

config BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST
	bool "libretro-beetle-pce-fast"
	default y
	help
	  PC Engine and PC Engine CD (Mednafen's; the CD's BIOS,
	  syscard3.pce, in bios/).

config BR2_PACKAGE_LIBRETRO_STELLA
	bool "libretro-stella"
	default y
	help
	  Atari 2600.

config BR2_PACKAGE_LIBRETRO_PROSYSTEM
	bool "libretro-prosystem"
	default y
	help
	  Atari 7800.

config BR2_PACKAGE_LIBRETRO_GEARCOLECO
	bool "libretro-gearcoleco"
	default y
	help
	  ColecoVision (its BIOS, colecovision.rom, in bios/).

config BR2_PACKAGE_LIBRETRO_FREEINTV
	bool "libretro-freeintv"
	default y
	help
	  Intellivision (its BIOS, exec.bin and grom.bin, in bios/).

config BR2_PACKAGE_LIBRETRO_VECX
	bool "libretro-vecx"
	default y
	help
	  Vectrex (its BIOS built in).

config BR2_PACKAGE_LIBRETRO_O2EM
	bool "libretro-o2em"
	default y
	help
	  Odyssey 2 / Videopac (its BIOS, o2rom.bin, in bios/).

config BR2_PACKAGE_LIBRETRO_FBNEO
	bool "libretro-fbneo"
	default y
	help
	  FinalBurn Neo: arcade games, Neo Geo (its BIOS, neogeo.zip,
	  in bios/) and Capcom's CPS-1, CPS-2 and CPS-3.

config BR2_PACKAGE_RETROARCH_GLSL_SHADERS
	bool "retroarch-glsl-shaders"
	default y
	help
	  libretro's GLSL shader presets for RetroArch's GL driver.

config BR2_PACKAGE_LIBRETRO_CHEATS_NDS
	bool "libretro-cheats-nds"
	default y
	help
	  libretro-database's Action Replay cheats for the Nintendo DS,
	  read by BananaDS's Cheats.
